{
  "name": "map-route-planner",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker:transcription": "ts-node src/workers/transcriptionWorker.ts",
    "test:transcription": "powershell -ExecutionPolicy Bypass -File .\\scripts\\transcription-full-test.ps1",
    "test:route-search": "powershell -ExecutionPolicy Bypass -File .\\scripts\\route-search-full-test.ps1",
    "test:websocket": "powershell -ExecutionPolicy Bypass -File .\\scripts\\websocket-route-search-full-test.ps1",
    "db:reset-routes": "node scripts/reset-realistic-route-graph.cjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text --coverageReporters=text-summary --coverageReporters=json-summary --coverageReporters=lcov",
    "test:integration": "cross-env RUN_DOCKER_TESTS=1 jest --runInBand src/integration/security.integration.test.ts",
    "test:contract": "cross-env RUN_DOCKER_TESTS=1 jest --runInBand src/contract/contract.business-processes.test.ts",
    "coverage:metrics": "node scripts/coverage-metrics.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "amqplib": "^1.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.3",
    "neo4j-driver": "^6.0.1",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
