MONGO_URI=mongodb://127.0.0.1:27017/map-route-planner
JWT_SECRET=change-me-in-production
PORT=5000

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=app.events

ROUTE_SEARCH_EXCHANGE=app.events
ROUTE_SEARCH_REQUEST_QUEUE=route-search.requests
ROUTE_SEARCH_EVENTS_QUEUE=route-search.backend.events
ROUTE_SEARCH_BACKEND_PREFETCH=10

# Python worker uses the same RabbitMQ URL and Neo4j credentials
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# S3-compatible storage (MinIO, AWS S3, etc.)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=transcription-results
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
